diff --git a/ds4_qwen35_cuda.cuh b/ds4_qwen35_cuda.cuh
index 3a7af1e6..9b1d35d8 100644
--- a/ds4_qwen35_cuda.cuh
+++ b/ds4_qwen35_cuda.cuh
@@ -44,3 +44,47 @@ extern "C" int ds4_gpu_qwen35_gdn_out_tensor(
         (float *)o->ptr, (const float *)z->ptr, (const float *)w, eps, H, D);
     return launched();
 }
+
+extern "C" int ds4_gpu_qwen35_attn_prep_tensor(
+        ds4_gpu_tensor *q, ds4_gpu_tensor *gate, ds4_gpu_tensor *kc, ds4_gpu_tensor *vc,
+        const ds4_gpu_tensor *qg, const ds4_gpu_tensor *kp, const ds4_gpu_tensor *vp,
+        const ds4_gpu_tensor *pos3, const void *map, uint64_t size, uint64_t qo, uint64_t ko,
+        uint32_t T, uint32_t H, uint32_t Hkv, uint32_t D, uint32_t nrot,
+        uint32_t pos0, uint32_t cap, float base, float eps) {
+    using namespace qwen4_cuda;
+    if (!T || !H || !Hkv || H % Hkv || D < 32u || D > 256u || D % 32u || nrot > 64u || nrot > D ||
+        nrot % 2u || (uint64_t)pos0 + T > cap ||
+        !(base > 1.0f && base < 3.402823466e+38f) ||
+        !(eps > 0.0f && eps < 3.402823466e+38f)) return 0;
+    const uint64_t qb = (uint64_t)T * H * D * 4, kb = (uint64_t)T * Hkv * D * 4;
+    const uint64_t cb = (uint64_t)cap * Hkv * D * 2;
+    const char *gq = weight(map, size, qo, (uint64_t)D * 4);
+    const char *gk = weight(map, size, ko, (uint64_t)D * 4);
+    if (!tensor(q, qb) || !tensor(gate, qb) || !tensor(qg, qb * 2) || !tensor(kp, kb) ||
+        !tensor(vp, kb) || !tensor(kc, cb) || !tensor(vc, cb) ||
+        !tensor(pos3, (uint64_t)cap * 16) || !gq || !gk) return 0;
+    /* The shared prep kernel also serves the Qwen4 indexer. Dense qwen35 has no
+     * indexer, so its tensors are null and its head and dim counts are zero. */
+    attn_prep<<<dim3(H + Hkv + 1, T), 32, 0, cuda_decode_stream()>>>(
+        (float *)q->ptr, (float *)gate->ptr, (__half *)kc->ptr, (__half *)vc->ptr,
+        NULL, NULL, (const float *)qg->ptr, (const float *)kp->ptr, (const float *)vp->ptr,
+        NULL, NULL, (const uint32_t *)pos3->ptr, (const float *)gq, (const float *)gk, NULL,
+        H, Hkv, D, 0, 0, pos0, eps, rope(nrot, base));
+    return launched();
+}
+
+extern "C" int ds4_gpu_qwen35_attn_fa_tensor(
+        ds4_gpu_tensor *out, const ds4_gpu_tensor *q, const ds4_gpu_tensor *gate,
+        const ds4_gpu_tensor *kc, const ds4_gpu_tensor *vc,
+        uint32_t T, uint32_t H, uint32_t Hkv, uint32_t D, uint32_t pos0, float scale) {
+    using namespace qwen4_cuda;
+    if (!T || D != 256u || !H || !Hkv || H % Hkv ||
+        !(scale > 0.0f && scale < 3.402823466e+38f)) return 0;
+    const uint64_t qb = (uint64_t)T * H * D * 4, cb = ((uint64_t)pos0 + T) * Hkv * D * 2;
+    if (!tensor(out, qb) || !tensor(q, qb) || !tensor(gate, qb) ||
+        !tensor(kc, cb) || !tensor(vc, cb)) return 0;
+    /* Dense causal attention is the shared entry point's non-sparse path: the
+     * selection tensors are null, sparse is false and the stride is unused. */
+    return ds4_gpu_qwen4_attn_decode_tensor(out, q, gate, kc, vc, NULL, NULL, NULL,
+                                            T, H, Hkv, D, pos0, false, 0u, scale);
+}
