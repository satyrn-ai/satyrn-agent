--- a/tests/qwen35_cuda_test.c
+++ b/tests/qwen35_cuda_test.c
@@ -71,6 +71,76 @@ ds4_gpu_tensor *q35_upload(const float *data, uint64_t count) {
     return t;
 }
 
+float q35_half_to_float(uint16_t h) {
+    const uint32_t sign = (uint32_t)(h & 0x8000u) << 16;
+    uint32_t exp = (h >> 10) & 0x1fu, man = h & 0x3ffu, bits;
+    if (exp == 0) {
+        if (man == 0) {
+            bits = sign;
+        } else {
+            exp = 127u - 15u + 1u;
+            while ((man & 0x400u) == 0) {
+                man <<= 1;
+                exp--;
+            }
+            man &= 0x3ffu;
+            bits = sign | (exp << 23) | (man << 13);
+        }
+    } else if (exp == 31) {
+        bits = sign | 0x7f800000u | (man << 13);
+    } else {
+        bits = sign | ((exp + 127u - 15u) << 23) | (man << 13);
+    }
+    float f;
+    memcpy(&f, &bits, sizeof(f));
+    return f;
+}
+
+uint16_t q35_float_to_half(float f) {
+    uint32_t bits;
+    memcpy(&bits, &f, sizeof(bits));
+    const uint32_t sign = (bits >> 16) & 0x8000u, fexp = (bits >> 23) & 0xffu, man = bits & 0x7fffffu;
+    if (fexp == 0xffu) return (uint16_t)(sign | 0x7c00u | (man ? 0x200u : 0));
+    const int32_t exp = (int32_t)fexp - 127 + 15;
+    if (exp >= 31) return (uint16_t)(sign | 0x7c00u);
+    if (exp <= 0) {
+        if (exp < -10) return (uint16_t)sign;
+        const uint32_t m = man | 0x800000u, shift = (uint32_t)(14 - exp);
+        uint32_t half = m >> shift;
+        const uint32_t rest = m & ((1u << shift) - 1u), halfway = 1u << (shift - 1u);
+        if (rest > halfway || (rest == halfway && (half & 1u))) half++;
+        return (uint16_t)(sign | half);
+    }
+    uint32_t half = sign | ((uint32_t)exp << 10) | (man >> 13);
+    const uint32_t rest = man & 0x1fffu;
+    if (rest > 0x1000u || (rest == 0x1000u && (half & 1u))) half++;
+    return (uint16_t)half;
+}
+
+ds4_gpu_tensor *q35_upload_raw(const void *data, uint64_t bytes) {
+    ds4_gpu_tensor *t = ds4_gpu_tensor_alloc(bytes);
+    q35_require(t != NULL, "ds4_gpu_tensor_alloc");
+    q35_require(ds4_gpu_tensor_write(t, 0, data, bytes), "ds4_gpu_tensor_write");
+    return t;
+}
+
+void q35_check_half_tensor(const char *what, const ds4_gpu_tensor *tensor,
+                           const double *expect, uint64_t count, double tolerance) {
+    const uint64_t bytes = count * sizeof(uint16_t);
+    uint16_t *actual = q35_alloc(bytes ? bytes : sizeof(uint16_t));
+    q35_require(ds4_gpu_tensor_read(tensor, 0, actual, bytes), "ds4_gpu_tensor_read");
+    for (uint64_t i = 0; i < count; i++) {
+        const double want = expect[i], got = (double)q35_half_to_float(actual[i]);
+        if (!(fabs(got - want) <= tolerance * (1.0 + fabs(want)))) {
+            fprintf(stderr, "qwen35 test: %s[%llu] got %.9g want %.9g\n", what,
+                    (unsigned long long)i, got, want);
+            free(actual);
+            exit(1);
+        }
+    }
+    free(actual);
+}
+
 void q35_check_tensor(const char *what, const ds4_gpu_tensor *tensor,
                       const double *expect, uint64_t count, double tolerance) {
     const uint64_t bytes = count * sizeof(float);
