+/* Decode for T<=8 goes through the integer dp4a path, which quantises the
+ * activations to q8_K: the result differs from exact float dequant by the
+ * activation quantisation error, the same trade the MoE decode already makes.
+ * T>8 keeps the exact float matrix path, so its tolerance stays tight. */
+#define Q35_TOL_DP4A 2e-2
+#define Q35_TOL_EXACT 5e-5
+
+static double q35_tol(unsigned T) { return T <= 8u ? Q35_TOL_DP4A : Q35_TOL_EXACT; }
+
+static void q4k_encode(unsigned char *block, const uint8_t *q, const uint8_t *scales) {
+    const uint16_t d = 0x1400u, dmin = 0x0c00u;
+    memcpy(block, &d, sizeof(d));
+    memcpy(block + 2, &dmin, sizeof(dmin));
+    memcpy(block + 4, scales, 12);
+    memset(block + 16, 0, 128);
+    for (unsigned j = 0; j < 256u; j++) {
+        const unsigned idx = j / 64u * 32u + j % 32u;
+        block[16u + idx] |= (unsigned char)((q[j] & 15u) << (4u * ((j / 32u) & 1u)));
+    }
+}
+
+static double q4k_value(const unsigned char *row, unsigned k) {
+    const unsigned char *b = row + (k / 256u) * 144u;
+    const unsigned j = k % 256u, group = j / 32u;
+    unsigned sc, mn;
+    if (group < 4u) {
+        sc = b[4u + group] & 63u;
+        mn = b[4u + group + 4u] & 63u;
+    } else {
+        sc = (b[4u + group + 4u] & 15u) | ((unsigned)(b[4u + group - 4u] >> 6) << 4);
+        mn = (b[4u + group + 4u] >> 4) | ((unsigned)(b[4u + group] >> 6) << 4);
+    }
+    const unsigned q = (b[16u + j / 64u * 32u + j % 32u] >> (4u * (group & 1u))) & 15u;
+    uint16_t d, dmin;
+    memcpy(&d, b, sizeof(d));
+    memcpy(&dmin, b + 2, sizeof(dmin));
+    return (double)q35_half_to_float(d) * (double)sc * (double)q -
+           (double)q35_half_to_float(dmin) * (double)mn;
+}
+
+/* Compare against the magnitude of the accumulation, not against the result:
+ * a dot product that cancels to near zero still carries the quantisation error
+ * of its terms, so scaling the bound by |result| alone would fail arbitrarily. */
+static void q35_check_dot(const char *what, const ds4_gpu_tensor *tensor,
+                          const double *expect, const double *magnitude,
+                          uint64_t count, double tolerance) {
+    float *actual = q35_alloc(count * sizeof(float));
+    q35_require(ds4_gpu_tensor_read(tensor, 0, actual, count * sizeof(float)),
+                "ds4_gpu_tensor_read");
+    for (uint64_t i = 0; i < count; i++) {
+        const double got = (double)actual[i], want = expect[i];
+        if (!(fabs(got - want) <= tolerance * (1.0 + magnitude[i]))) {
+            fprintf(stderr, "qwen35 test: %s[%llu] got %.9g want %.9g mag %.6g\n", what,
+                    (unsigned long long)i, got, want, magnitude[i]);
+            free(actual);
+            exit(1);
+        }
+    }
+    free(actual);
+}
+
+static void q4k_case(uint32_t K, uint32_t M, uint32_t T) {
+    q35_require(K % 256u == 0u, "K must be a multiple of 256");
+    const uint64_t blocks = K / 256u, row_bytes = blocks * 144u;
+    const uint64_t weight_bytes = row_bytes * M;
+    unsigned char *weights = q35_alloc(weight_bytes);
+    for (uint32_t m = 0; m < M; m++) {
+        for (uint64_t b = 0; b < blocks; b++) {
+            uint8_t q[256], scales[12];
+            for (unsigned j = 0; j < 256u; j++) q[j] = (uint8_t)(q35_random() & 15u);
+            for (unsigned j = 0; j < 12u; j++) scales[j] = (uint8_t)(q35_random() & 0xffu);
+            q4k_encode(weights + m * row_bytes + b * 144u, q, scales);
+        }
+    }
+    q35_arena arena;
+    q35_arena_init(&arena, weight_bytes);
+    const uint64_t off = q35_arena_add(&arena, weights, weight_bytes);
+    q35_arena_bind(&arena);
+    free(weights);
+    float *x = q35_alloc((uint64_t)T * K * sizeof(float));
+    for (uint64_t i = 0; i < (uint64_t)T * K; i++) x[i] = q35_random_uniform();
+    double *expect = q35_alloc((uint64_t)T * M * sizeof(double));
+    double *mag = q35_alloc((uint64_t)T * M * sizeof(double));
+    for (uint32_t t = 0; t < T; t++) {
+        for (uint32_t m = 0; m < M; m++) {
+            double acc = 0, sum = 0;
+            for (uint32_t k = 0; k < K; k++) {
+                const double w = q4k_value(arena.base + off + m * row_bytes, k);
+                acc += (double)x[(uint64_t)t * K + k] * w;
+                sum += fabs((double)x[(uint64_t)t * K + k] * w);
+            }
+            expect[(uint64_t)t * M + m] = acc;
+            mag[(uint64_t)t * M + m] = sum;
+        }
+    }
+    ds4_gpu_tensor *xt = q35_upload(x, (uint64_t)T * K);
+    ds4_gpu_tensor *out = ds4_gpu_tensor_alloc((uint64_t)T * M * sizeof(float));
+    q35_require(out != NULL, "output tensor");
+    q35_require(ds4_gpu_qwen4_dense_mm_tensor(out, xt, arena.base, arena.size, off, 12, T, K, M),
+                "Q4_K dense mm");
+    char what[96];
+    snprintf(what, sizeof(what), "Q4_K K=%u M=%u T=%u", K, M, T);
+    q35_check_dot(what, out, expect, mag, (uint64_t)T * M,
+                  T <= 8u ? Q35_TOL_DP4A : Q35_TOL_EXACT);
+    ds4_gpu_tensor_free(out);
+    ds4_gpu_tensor_free(xt);
+    q35_arena_free(&arena);
+    free(x);
+    free(expect);
+    free(mag);
+}
