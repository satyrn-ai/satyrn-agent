+/* Q6_K block dot. The 210-byte block stride leaves most blocks off a 4-byte
+ * boundary, so the quantised bytes are assembled from byte loads instead of
+ * casting to int32: the -32 bias folds into the byte arithmetic, so the integer
+ * sum is exact and no bsums correction is needed. */
+__device__ __forceinline__ static void dev_dot_q6_K_q8_K_block(
+        const uint8_t *x, const cuda_block_q8_K *y, float *out_acc) {
+    const uint16_t dh = (uint16_t)x[208] | (uint16_t)((unsigned)x[209] << 8);
+    const float d = dev_f16_to_f32(dh);
+    const int8_t *sc = (const int8_t *)(x + 192);
+    int isum[16] = {0};
+    #pragma unroll
+    for (unsigned half = 0; half < 2u; half++) {
+        #pragma unroll
+        for (unsigned part = 0; part < 4u; part++) {
+            const unsigned shift = 4u * (part >> 1u), s2 = 2u * part;
+            const uint8_t *ql = x + half * 64u + (part & 1u) * 32u;
+            const uint8_t *qh = x + 128u + half * 32u;
+            #pragma unroll
+            for (unsigned w = 0; w < 8u; w++) {
+                const unsigned base = w * 4u;
+                int32_t v = 0;
+                #pragma unroll
+                for (unsigned k = 0; k < 4u; k++) {
+                    const unsigned lo = (ql[base + k] >> shift) & 15u;
+                    const unsigned hi = (qh[base + k] >> s2) & 3u;
+                    const int q = (int)(lo | (hi << 4u)) - 32;
+                    v |= (int32_t)((unsigned)q & 0xffu) << (8u * k);
+                }
+                const unsigned j = half * 128u + part * 32u + base;
+                isum[j / 16u] = __dp4a(v, *(const int32_t *)(y->qs + j), isum[j / 16u]);
+            }
+        }
+    }
+    int total = 0;
+    #pragma unroll
+    for (unsigned i = 0; i < 16u; i++) total += (int)sc[i] * isum[i];
+    *out_acc += y->d * d * (float)total;
+}
