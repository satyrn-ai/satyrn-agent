+#ifndef QWEN35_CUDA_TEST_H
+#define QWEN35_CUDA_TEST_H
+
+/* Shared helpers for the dense qwen35 CUDA test programs. Each test allocates
+ * its weights in an arena, binds the arena as the model map, uploads
+ * activations and compares device output against its own reference. */
+
+#include "ds4_gpu.h"
+
+#include <stdint.h>
+
+typedef struct {
+    unsigned char *base;
+    uint64_t size;
+    uint64_t used;
+} q35_arena;
+
+void q35_init(void);
+void q35_cleanup(void);
+void q35_require(int condition, const char *what);
+void *q35_alloc(uint64_t bytes);
+uint32_t q35_random(void);
+float q35_random_uniform(void);
+
+void q35_arena_init(q35_arena *arena, uint64_t size);
+uint64_t q35_arena_add(q35_arena *arena, const void *data, uint64_t bytes);
+void q35_arena_bind(const q35_arena *arena);
+void q35_arena_free(q35_arena *arena);
+
+ds4_gpu_tensor *q35_upload(const float *data, uint64_t count);
+void q35_check_tensor(const char *what, const ds4_gpu_tensor *tensor,
+                      const double *expect, uint64_t count, double tolerance);
+
+#endif
diff --git a/tests/test_qwen35_cuda_quant.c b/tests/test_qwen35_cuda_quant.c
new file mode 100644
index 00000000..e05ec63d
--- /dev/null
+++ b/tests/test_qwen35_cuda_quant.c
@@ -0,0 +1,173 @@
+#define _POSIX_C_SOURCE 200809L
+#include "qwen35_cuda_test.h"
+
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Dense qwen35 uses Q6_K for the output head and for two tensors in every
+ * layer, so the shared Qwen CUDA path must decode it in all four dispatch
+ * layers: matvec (T <= 8), tensor-core and plain matrix (9 <= T < 32) and the
+ * cuBLAS unpack path (T >= 32). This test encodes weights with its own
+ * arithmetic and decodes them again with its own reader; it never calls the
+ * kernel helper it is checking. */
+
+#define Q6K_BLOCK 210u
+#define Q6K_QUANT 256u
+
+/* Half-precision values the encoder uses, as raw bits: 2^-10, 2^-8, 2^-12. */
+static const uint16_t q6k_d[] = { 0x1400u, 0x1c00u, 0x0c00u };
+
+static float half_to_float(uint16_t h) {
+    const uint32_t sign = (uint32_t)(h & 0x8000u) << 16;
+    uint32_t exp = (h >> 10) & 0x1fu, man = h & 0x3ffu, bits;
+    if (exp == 0) {
+        if (man == 0) {
+            bits = sign;
+        } else {
+            exp = 127u - 15u + 1u;
+            while ((man & 0x400u) == 0) {
+                man <<= 1;
+                exp--;
+            }
+            man &= 0x3ffu;
+            bits = sign | (exp << 23) | (man << 13);
+        }
+    } else if (exp == 31) {
+        bits = sign | 0x7f800000u | (man << 13);
+    } else {
+        bits = sign | ((exp + 127u - 15u) << 23) | (man << 13);
+    }
+    float f;
+    memcpy(&f, &bits, sizeof(f));
+    return f;
+}
+
+/* Block layout: 128 low nibbles, 128 high 2-bit parts at byte 128, sixteen
+ * int8 scales at byte 192, fp16 d at byte 208. Value j is
+ * d * scale(j / 16) * ((low | high << 4) - 32). */
+static void q6k_encode(unsigned char *block, const uint8_t *q, int8_t scale, uint16_t d) {
+    memset(block, 0, Q6K_BLOCK);
+    for (unsigned j = 0; j < Q6K_QUANT; j++) {
+        const unsigned half = j / 128u, part = (j % 128u) / 32u, lane = j % 32u;
+        const unsigned lo = q[j] & 15u, hi = (q[j] >> 4) & 3u;
+        block[half * 64u + (part & 1u) * 32u + lane] |= (unsigned char)(lo << (4u * (part / 2u)));
+        block[128u + half * 32u + lane] |= (unsigned char)(hi << (2u * part));
+        ((int8_t *)block)[192u + j / 16u] = scale;
+    }
+    memcpy(block + 208, &d, sizeof(d));
+}
+
+static double q6k_value(const unsigned char *row, unsigned k) {
+    const unsigned char *block = row + (size_t)(k / Q6K_QUANT) * Q6K_BLOCK;
+    const unsigned j = k % Q6K_QUANT;
+    const unsigned half = j / 128u, part = (j % 128u) / 32u, lane = j % 32u;
+    const unsigned lo = (block[half * 64u + (part & 1u) * 32u + lane] >> (4u * (part / 2u))) & 15u;
+    const unsigned hi = (block[128u + half * 32u + lane] >> (2u * part)) & 3u;
+    const int q = (int)(lo | (hi << 4)) - 32;
+    const int scale = ((const int8_t *)block)[192u + j / 16u];
+    uint16_t d;
+    memcpy(&d, block + 208, sizeof(d));
+    return (double)half_to_float(d) * (double)scale * (double)q;
+}
+
+static void q6k_case(uint32_t K, uint32_t M, uint32_t T) {
+    q35_require(K % Q6K_QUANT == 0, "K must be a multiple of 256");
+    const uint64_t blocks = K / Q6K_QUANT;
+    const uint64_t row_bytes = blocks * Q6K_BLOCK;
+    const uint64_t weight_bytes = row_bytes * M;
+
+    unsigned char *weights = q35_alloc(weight_bytes);
+    for (uint32_t m = 0; m < M; m++) {
+        for (uint64_t b = 0; b < blocks; b++) {
+            uint8_t q[Q6K_QUANT];
+            for (unsigned j = 0; j < Q6K_QUANT; j++) q[j] = (uint8_t)(q35_random() & 63u);
+            const int8_t scale = (int8_t)(1u + q35_random() % 7u);
+            q6k_encode(weights + m * row_bytes + b * Q6K_BLOCK, q, scale,
+                       q6k_d[q35_random() % 3u]);
+        }
+    }
+
+    q35_arena arena;
+    q35_arena_init(&arena, weight_bytes);
+    const uint64_t off = q35_arena_add(&arena, weights, weight_bytes);
+    q35_arena_bind(&arena);
+    free(weights);
+
+    float *x = q35_alloc((uint64_t)T * K * sizeof(float));
+    for (uint64_t i = 0; i < (uint64_t)T * K; i++) x[i] = q35_random_uniform();
+
+    double *expect = q35_alloc((uint64_t)T * M * sizeof(double));
+    for (uint32_t t = 0; t < T; t++) {
+        for (uint32_t m = 0; m < M; m++) {
+            double acc = 0;
+            for (uint32_t k = 0; k < K; k++)
+                acc += (double)x[(uint64_t)t * K + k] *
+                       q6k_value(arena.base + off + m * row_bytes, k);
+            expect[(uint64_t)t * M + m] = acc;
+        }
+    }
+
+    ds4_gpu_tensor *xt = q35_upload(x, (uint64_t)T * K);
+    ds4_gpu_tensor *out = ds4_gpu_tensor_alloc((uint64_t)T * M * sizeof(float));
+    q35_require(out != NULL, "output tensor");
+    q35_require(ds4_gpu_qwen4_dense_mm_tensor(out, xt, arena.base, arena.size, off, 14, T, K, M),
+                "Q6_K dense mm");
+    char what[96];
+    snprintf(what, sizeof(what), "Q6_K K=%u M=%u T=%u", K, M, T);
+    q35_check_tensor(what, out, expect, (uint64_t)T * M, 5e-5);
+
+    ds4_gpu_tensor_free(out);
+    ds4_gpu_tensor_free(xt);
+    free(expect);
+    free(x);
+    q35_arena_free(&arena);
+}
+
+static void q6k_refusals(void) {
+    q35_arena arena;
+    q35_arena_init(&arena, 4096);
+    q35_arena_bind(&arena);
+
+    float x[4] = { 1, 2, 3, 4 };
+    ds4_gpu_tensor *xt = q35_upload(x, 4);
+    ds4_gpu_tensor *out = ds4_gpu_tensor_alloc(64);
+    q35_require(out != NULL, "refusal output tensor");
+
+    /* K is not a multiple of 256, so no valid row stride exists. */
+    q35_require(!ds4_gpu_qwen4_dense_mm_tensor(out, xt, arena.base, arena.size, 0, 14, 1, 384, 1),
+                "Q6_K must refuse K=384");
+    /* The output tensor is one byte short of T*M floats. */
+    q35_require(!ds4_gpu_qwen4_dense_mm_tensor(out, xt, arena.base, arena.size, 0, 14, 1, 256, 17),
+                "Q6_K must refuse a short output view");
+
+    ds4_gpu_tensor_free(out);
+    ds4_gpu_tensor_free(xt);
+    q35_arena_free(&arena);
+}
+
+int main(void) {
+    q35_init();
+    const uint32_t ks[] = { 256, 512 }, ms[] = { 1, 4 }, ts[] = { 1, 8, 9, 17, 32, 33 };
+    for (unsigned a = 0; a < sizeof(ks) / sizeof(ks[0]); a++)
+        for (unsigned b = 0; b < sizeof(ms) / sizeof(ms[0]); b++)
+            for (unsigned c = 0; c < sizeof(ts) / sizeof(ts[0]); c++)
+                q6k_case(ks[a], ms[b], ts[c]);
+
+    /* Force the tensor-core layer off so the plain matrix kernel runs; the
+     * cuBLAS path has no disable knob, so T >= 32 always exercises unpack. */
+    setenv("DS4_CUDA_NO_TF32", "1", 1);
+    for (unsigned a = 0; a < sizeof(ks) / sizeof(ks[0]); a++)
+        for (unsigned b = 0; b < sizeof(ms) / sizeof(ms[0]); b++) {
+            q6k_case(ks[a], ms[b], 9);
+            q6k_case(ks[a], ms[b], 17);
+        }
+    unsetenv("DS4_CUDA_NO_TF32");
+
+    q6k_refusals();
+    q35_cleanup();
+    printf("all qwen35 CUDA quant tests passed\n");
+    return 0;
+}
