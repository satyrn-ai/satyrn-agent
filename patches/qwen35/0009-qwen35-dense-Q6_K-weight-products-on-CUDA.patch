diff --git a/tests/qwen35_cuda_test.c b/tests/qwen35_cuda_test.c
new file mode 100644
index 00000000..20f39ea9
--- /dev/null
+++ b/tests/qwen35_cuda_test.c
@@ -0,0 +1,90 @@
+#define _POSIX_C_SOURCE 200809L
+#include "qwen35_cuda_test.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static uint32_t q35_state = 0x9e3779b9u;
+
+void q35_init(void) {
+    q35_require(ds4_gpu_init(), "ds4_gpu_init");
+}
+
+void q35_cleanup(void) {
+    ds4_gpu_cleanup();
+}
+
+void q35_require(int condition, const char *what) {
+    if (!condition) {
+        fprintf(stderr, "qwen35 test: %s\n", what);
+        exit(1);
+    }
+}
+
+void *q35_alloc(uint64_t bytes) {
+    void *p = calloc(1, (size_t)bytes);
+    q35_require(p != NULL, "host allocation");
+    return p;
+}
+
+uint32_t q35_random(void) {
+    q35_state = q35_state * 1664525u + 1013904223u;
+    return q35_state;
+}
+
+float q35_random_uniform(void) {
+    return (float)((int32_t)(q35_random() >> 16) - 32768) / 16384.0f;
+}
+
+void q35_arena_init(q35_arena *arena, uint64_t size) {
+    arena->base = q35_alloc(size ? size : 1);
+    arena->size = size;
+    arena->used = 0;
+}
+
+uint64_t q35_arena_add(q35_arena *arena, const void *data, uint64_t bytes) {
+    const uint64_t off = arena->used;
+    q35_require(off + bytes <= arena->size, "arena capacity");
+    if (bytes) memcpy(arena->base + off, data, (size_t)bytes);
+    arena->used = off + bytes;
+    return off;
+}
+
+void q35_arena_bind(const q35_arena *arena) {
+    q35_require(ds4_gpu_set_model_map(arena->base, arena->size), "ds4_gpu_set_model_map");
+}
+
+void q35_arena_free(q35_arena *arena) {
+    free(arena->base);
+    arena->base = NULL;
+    arena->size = 0;
+    arena->used = 0;
+}
+
+ds4_gpu_tensor *q35_upload(const float *data, uint64_t count) {
+    const uint64_t bytes = count * sizeof(float);
+    ds4_gpu_tensor *t = ds4_gpu_tensor_alloc(bytes);
+    q35_require(t != NULL, "ds4_gpu_tensor_alloc");
+    q35_require(ds4_gpu_tensor_write(t, 0, data, bytes), "ds4_gpu_tensor_write");
+    return t;
+}
+
+void q35_check_tensor(const char *what, const ds4_gpu_tensor *tensor,
+                      const double *expect, uint64_t count, double tolerance) {
+    const uint64_t bytes = count * sizeof(float);
+    float *actual = q35_alloc(bytes);
+    q35_require(ds4_gpu_tensor_read(tensor, 0, actual, bytes), "ds4_gpu_tensor_read");
+    for (uint64_t i = 0; i < count; i++) {
+        const double want = expect[i];
+        const double got = (double)actual[i];
+        if (!(fabs(got - want) <= tolerance * (1.0 + fabs(want)))) {
+            fprintf(stderr, "qwen35 test: %s[%llu] got %.9g want %.9g\n", what,
+                    (unsigned long long)i, got, want);
+            free(actual);
+            exit(1);
+        }
+    }
+    free(actual);
+}
