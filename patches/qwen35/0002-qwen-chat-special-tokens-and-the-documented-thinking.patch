From fc25620ffa6f8e0ba0416fe26577ac0f91705737 Mon Sep 17 00:00:00 2001
From: Koudai Aono <koxudaxi@gmail.com>
Date: Fri, 2 Oct 2026 12:46:09 +0900
Subject: [PATCH 02/18] qwen: chat special tokens and the documented
 thinking-mode sampling

Renders <tool_response> and a system message's <tool_call> as the special tokens the template uses, and samples the Qwen family at the documented thinking-mode values (0.6, 0.95, 20, 0) in ds4-agent and ds4.

Upstream: offer upstream, after narrowing the system-message change so tool text stays plain
Retire-when: upstream renders these tokens and samples Qwen as documented
Carried-commits: 480df32 14212a9
---
 ds4.c                      | 20 ++++++++++++--------
 ds4_agent.c                | 21 ++++++++++++++++-----
 ds4_cli.c                  |  9 +++++++++
 tests/test_mellum_config.c | 11 ++++++-----
 4 files changed, 43 insertions(+), 18 deletions(-)

diff --git a/ds4.c b/ds4.c
index 5b4f1a1f..c5147593 100644
--- a/ds4.c
+++ b/ds4.c
@@ -45291,12 +45291,10 @@ static void bpe_tokenize_tool_response_text(ds4_vocab *vocab, const char *conten
     bpe_tokenize_wrapped_payload_text(vocab, content, "</tool_response>", out);
 }
 
-/* A qwen4 tool message's <tool_response> wrapper.  Mellum's template text encodes it as the
- * vocabulary's added tokens 31 and 32, which plain BPE text would not give; Flash Next keeps
- * the text form it always had. */
+/* A qwen4 tool message's <tool_response> wrapper.  The template text encodes it as the
+ * vocabulary's added tokens (31 and 32 in Mellum's), which plain BPE text would not give. */
 static void qwen4_tool_response_tag(ds4_vocab *vocab, const char *tag, token_vec *out) {
-    if (ds4_model_is_mellum()) tokenize_rendered_chat_vocab(vocab, tag, out);
-    else bpe_tokenize_text(vocab, tag, out);
+    tokenize_rendered_chat_vocab(vocab, tag, out);
 }
 
 void ds4_chat_append_message(ds4_engine *e, ds4_tokens *tokens, const char *role, const char *content) {
@@ -45306,6 +45304,11 @@ void ds4_chat_append_message(ds4_engine *e, ds4_tokens *tokens, const char *role
 
     if (ds4_model_is_qwen4()) {
         if (!strcmp(role, "tool") || !strcmp(role, "function")) {
+            /* The template's <tool_response> and </tool_response> are the
+             * vocabulary's own special tokens, as the model saw them in
+             * training; rendering them as plain BPE pieces showed the model
+             * text it never learned as a tool result. The result itself stays
+             * untrusted text that cannot spell a control token. */
             qwen4_chat_open(vocab, "user", tokens);
             qwen4_tool_response_tag(vocab, "<tool_response>\n", tokens);
             bpe_tokenize_tool_response_text(vocab, content, tokens);
@@ -45314,10 +45317,11 @@ void ds4_chat_append_message(ds4_engine *e, ds4_tokens *tokens, const char *role
             const char *name = (!strcmp(role, "system") || !strcmp(role, "developer")) ? "system" :
                                !strcmp(role, "assistant") ? "assistant" : "user";
             qwen4_chat_open(vocab, name, tokens);
-            /* Mellum's system turn carries the host's tools block, whose <tool_call> and
-             * </tool_call> the template's text encodes as tokens 29 and 30.  User text stays
+            /* The system message is the host's own trusted text: its <tool_call> and
+             * the like are the special tokens the model emits, as the template renders
+             * them.  Mellum's template encodes those tokens 29 and 30; user text stays
              * plain BPE, as for every model. */
-            if (!strcmp(name, "assistant") || (ds4_model_is_mellum() && !strcmp(name, "system"))) {
+            if (!strcmp(name, "assistant") || !strcmp(name, "system")) {
                 tokenize_rendered_chat_vocab(vocab, content, tokens);
             } else {
                 bpe_tokenize_text(vocab, content, tokens);
diff --git a/ds4_agent.c b/ds4_agent.c
index deadc450..3ff34ba6 100644
--- a/ds4_agent.c
+++ b/ds4_agent.c
@@ -1006,11 +1006,22 @@ static agent_config parse_options(int argc, char **argv) {
 static void agent_apply_model_sampling_defaults(
         ds4_engine               *engine,
         agent_generation_options *gen) {
-    if (!engine || !gen || !ds4_engine_is_glm_dsa(engine)) return;
-
-    if (!gen->temperature_set) gen->temperature = 1.0f;
-    if (!gen->top_p_set) gen->top_p = 0.95f;
-    if (!gen->min_p_set) gen->min_p = 0.0f;
+    if (!engine || !gen) return;
+
+    if (ds4_engine_is_glm_dsa(engine)) {
+        if (!gen->temperature_set) gen->temperature = 1.0f;
+        if (!gen->top_p_set) gen->top_p = 0.95f;
+        if (!gen->min_p_set) gen->min_p = 0.0f;
+    } else if (ds4_engine_is_qwen4(engine)) {
+        /* Qwen's documented thinking-mode sampling (the Qwen3 model cards'
+         * "Best Practices": temperature 0.6, top_p 0.95, top_k 20, min_p 0).
+         * Before this the family fell through to the generic defaults
+         * (temperature 1.0, top_p 1.0, min_p 0.05).  This front end has no
+         * top_k option, so top_k stays unset. */
+        if (!gen->temperature_set) gen->temperature = 0.6f;
+        if (!gen->top_p_set) gen->top_p = 0.95f;
+        if (!gen->min_p_set) gen->min_p = 0.0f;
+    }
 }
 
 static ds4_think_mode effective_think_mode(const agent_config *cfg) {
diff --git a/ds4_cli.c b/ds4_cli.c
