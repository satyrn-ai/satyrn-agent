+++ b/ds4_cli.c
@@ -545,6 +545,15 @@ static void cli_apply_model_sampling_defaults(
         if (!gen->top_p_set) gen->top_p = 0.95f;
         if (!gen->min_p_set) gen->min_p = 0.0f;
         return;
+    } else if (ds4_engine_is_qwen4(engine) && !ds4_engine_is_mellum(engine)) {
+        /* Qwen's documented thinking-mode sampling (the Qwen3 model cards'
+         * "Best Practices": temperature 0.6, top_p 0.95, top_k 20, min_p 0).
+         * Mellum keeps its engine table below.  This front end has no top_k
+         * option, so top_k stays unset. */
+        if (!gen->temperature_set) gen->temperature = 0.6f;
+        if (!gen->top_p_set) gen->top_p = 0.95f;
+        if (!gen->min_p_set) gen->min_p = 0.0f;
+        return;
     }
     /* The engine's table (Mellum: 1.0, 1.0, min_p 0).  This front end has no
      * top_k option, so top_k stays unset. */
