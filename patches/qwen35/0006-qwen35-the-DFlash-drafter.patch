+            for (uint32_t i = 0; i < D; i++) ss += (double)src[i] * src[i];
+            const double s = 1.0 / sqrt(ss / D + eps);
+            for (uint32_t i = 0; i < D; i++) y[i] = src[i] * s * w[i];
