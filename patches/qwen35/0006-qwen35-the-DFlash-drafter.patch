+static void test_dflash_attn(uint32_t n_rows, uint32_t H, uint32_t Hkv, uint32_t D, uint32_t slots,
+                             uint32_t window, uint32_t pos0) {
+    const float scale = 1.0f / sqrtf((float)D);
