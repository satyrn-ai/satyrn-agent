+        }
+    }
+    return qwen4_dispatch(QWEN4_K_QWEN35_ATTN_FA, &args, sizeof(args), b, 7,
+                          MTLSizeMake((n_tokens + Q - 1u) / Q, n_head, 1), MTLSizeMake(32, 4, 1), 0);
+}
