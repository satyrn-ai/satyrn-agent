diff --git a/tests/test_qwen35_host.c b/tests/test_qwen35_host.c
new file mode 100644
index 00000000..d79e99f0
--- /dev/null
+++ b/tests/test_qwen35_host.c
@@ -0,0 +1,185 @@
+/* Host-side gate checks for the dense qwen35 graph: no device, no model, no
+ * weights file. ../ds4.c is included so its static predicates are reachable,
+ * the pattern tests/test_deepseek41_graph.c and tests/test_qwen4_ngram_state.c
+ * already use. The link is the other half of the check: a neutral function that
+ * still called a Metal-only symbol would fail to link here. */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "../ds4.c"
+
+static ds4_tensor g_embd, g_out, g_out_norm;
+static ds4_tensor g_dense[2][12];
+static ds4_tensor g_alpha[2], g_beta[2];
+
+static ds4_tensor *shape_tensor(ds4_tensor *t, uint32_t type, uint64_t rows, uint64_t cols) {
+    memset(t, 0, sizeof(*t));
+    t->type = type;
+    t->ndim = 2;
+    t->dim[0] = cols;
+    t->dim[1] = rows;
+    t->elements = rows * cols;
+    t->bytes = t->elements * 2u;
+    return t;
+}
+
+/* The dims the graph reads come from g_ds4_shape, so a two-layer dense qwen35
+ * needs no GGUF: layer 0 is linear and layer 1 is full attention because the
+ * interval is 2. Interval 4 would make both linear and leave the attention
+ * gate untested. */
+static void shape_dense_qwen35(void) {
+    g_ds4_shape = DS4_SHAPE_QWEN35;
+    g_ds4_shape.n_layer = 2;
+    g_ds4_shape.n_embd = 512;
+    g_ds4_shape.n_vocab = 32;
+    g_ds4_shape.n_head = 2;
+    g_ds4_shape.n_head_kv = 1;
+    g_ds4_shape.n_head_dim = 256;
+    g_ds4_shape.n_value_dim = 256;
+    g_ds4_shape.n_rot = 64;
+    g_ds4_shape.n_ff_dense = 512;
+    g_ds4_shape.n_full_attn_interval = 2;
+    g_ds4_shape.n_nextn_predict = 0;
+    g_ds4_shape.n_lin_k_head = 2;
+    g_ds4_shape.n_lin_v_head = 2;
+    g_ds4_shape.n_lin_head_dim = 128;
+    g_ds4_shape.n_lin_conv = 4;
+}
+
+static void build_weights(ds4_weights *w) {
+    memset(w, 0, sizeof(*w));
+    w->token_embd = shape_tensor(&g_embd, DS4_TENSOR_F32, 32, 512);
+    /* The output head contracts over the embedding width, so that is dim[0]. */
+    w->output = shape_tensor(&g_out, DS4_TENSOR_F32, 32, 512);
+    w->output_norm = shape_tensor(&g_out_norm, DS4_TENSOR_F32, 1, 512);
+    for (unsigned il = 0; il < 2; il++) {
+        ds4_layer_weights *l = &w->layer[il];
+        for (unsigned i = 0; i < 12; i++) shape_tensor(&g_dense[il][i], DS4_TENSOR_F32, 512, 512);
+        shape_tensor(&g_alpha[il], DS4_TENSOR_F32, 512, 16);
+        shape_tensor(&g_beta[il], DS4_TENSOR_F32, 512, 16);
+        l->lin_qkv = &g_dense[il][0];
+        l->lin_gate = &g_dense[il][1];
+        l->lin_beta = &g_beta[il];
+        l->lin_alpha = &g_alpha[il];
+        l->lin_out = &g_dense[il][4];
+        l->attn_q = &g_dense[il][5];
+        l->attn_k = &g_dense[il][6];
+        l->attn_v = &g_dense[il][7];
+        l->attn_output = &g_dense[il][8];
+        l->ffn_gate = &g_dense[il][9];
+        l->ffn_up = &g_dense[il][10];
+        l->ffn_down = &g_dense[il][11];
+        l->attn_norm = &g_dense[il][0];
+        l->ffn_norm = &g_dense[il][1];
+        l->lin_norm = &g_dense[il][2];
+        l->lin_conv = &g_dense[il][3];
+        l->lin_a = &g_dense[il][5];
+        l->lin_dt_bias = &g_dense[il][6];
+    }
+}
+
+/* Run the verdict with stderr diverted, so a test can tell "refused" from
+ * "refused while still claiming qwen35 needs Metal". */
+static bool verdict(const ds4_weights *w, char *message, size_t capacity) {
+    char path[] = "/tmp/qwen35-host-XXXXXX";
+    const int fd = mkstemp(path);
+    if (fd < 0) {
+        perror("mkstemp");
+        exit(1);
+    }
+    fflush(stderr);
+    const int saved = dup(STDERR_FILENO);
+    if (saved < 0 || dup2(fd, STDERR_FILENO) < 0) {
+        perror("dup");
+        exit(1);
+    }
+    const bool ok = qwen35_graph_weights_supported(w);
+    fflush(stderr);
+    if (dup2(saved, STDERR_FILENO) < 0) {
+        perror("dup2");
+        exit(1);
+    }
+    close(saved);
+    if (capacity) message[0] = '\0';
+    if (capacity) {
+        FILE *in = fdopen(fd, "r");
+        if (!in) {
+            perror("fdopen");
+            exit(1);
+        }
+        size_t n = fread(message, 1, capacity - 1, in);
+        message[n] = '\0';
+        fclose(in);
+    } else {
+        close(fd);
+    }
+    unlink(path);
+    return ok;
+}
+
+static void expect(bool got, const char *what) {
+    if (!got) {
+        fprintf(stderr, "qwen35 host test: %s\n", what);
+        exit(1);
+    }
+}
+
+int main(void) {
+    shape_dense_qwen35();
+    ds4_weights w;
+    build_weights(&w);
+
+    char message[512];
+    expect(verdict(&w, message, sizeof(message)), "a dense layout is accepted on this backend");
+    if (strstr(message, "runs on the Metal graph only")) {
+        fprintf(stderr, "qwen35 host test: %s", message);
+        return 1;
+    }
+
+    /* Q6_K dense weights are in the supported set: the output head and two
+     * per-layer tensors, at widths the row stride accepts. */
+    g_out.type = DS4_TENSOR_Q6_K;
+    expect(verdict(&w, NULL, 0), "Q6_K output head");
+    g_dense[1][11].type = DS4_TENSOR_Q6_K;
+    expect(verdict(&w, NULL, 0), "Q6_K ffn_down");
+    g_dense[0][0].type = DS4_TENSOR_Q6_K;
+    expect(verdict(&w, NULL, 0), "Q6_K lin_qkv");
+    g_dense[0][0].type = DS4_TENSOR_F32;
+    g_dense[1][11].type = DS4_TENSOR_F32;
+    g_out.type = DS4_TENSOR_F32;
+
+    /* Q5_K stays out of the dense set while D1 holds. */
+    g_dense[0][11].type = DS4_TENSOR_Q5_K;
+    expect(!verdict(&w, NULL, 0), "Q5_K refused");
+    g_dense[0][11].type = DS4_TENSOR_F32;
+
+    /* A Q6_K embedding is refused by name, and a K-quant narrower than one
+     * block cannot be read by the strided kernels. */
+    g_embd.type = DS4_TENSOR_Q6_K;
+    expect(!verdict(&w, NULL, 0), "Q6_K token embedding refused");
+    g_embd.type = DS4_TENSOR_F32;
+    g_dense[1][9].type = DS4_TENSOR_Q6_K;
+    g_dense[1][9].dim[0] = 128;
+    expect(!verdict(&w, NULL, 0), "Q6_K width below one block refused");
+    g_dense[1][9].dim[0] = 512;
+    g_dense[1][9].type = DS4_TENSOR_F32;
+
+    /* The fused decode front reads alpha and beta through one dot, so the two
+     * must share a type and neither may be Q6_K. Layer 0 is the linear one. */
+    g_beta[0].type = DS4_TENSOR_Q8_0;
+    expect(!verdict(&w, NULL, 0), "mismatched alpha/beta types refused");
+    g_beta[0].type = DS4_TENSOR_F32;
+    expect(verdict(&w, NULL, 0), "matching alpha/beta types accepted");
+
+#if defined(__APPLE__)
+    /* The verify and DFlash helpers are Apple-only by design: on a CUDA build
+     * this binary links only because no neutral function calls them. */
+    (void)&qwen35_graph_verify_mode;
+    (void)&qwen35_graph_verify_alloc;
+#endif
+
+    printf("all qwen35 host gate tests passed\n");
+    return 0;
+}
