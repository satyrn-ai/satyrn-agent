+static bool mellum_stream_load(void *ctx, uint32_t layer, const int32_t *ids, uint32_t n) {
+    mellum_stream_ctx *c = ctx;
+    return mellum_stream_load_ids(c->m, &c->w->layer[layer], layer, ids, n, &c->g->mellum_stream_loads);
