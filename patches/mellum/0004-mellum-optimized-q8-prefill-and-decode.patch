+            const float m_new = max(m, s);
+            const float corr = exp(m - m_new);
+            const float w = exp(s - m_new);
+            l = l * corr + w;
+            acc = acc * corr + w * vf[j];
+            m = m_new;
+        }
+    }
+    if (tiisg == 0u) {
+        part_m[sgitg] = m;
+        part_l[sgitg] = l;
+        part_bad[sgitg] = bad;
+    }
+    *reinterpret_cast<threadgroup float4 *>(&part_acc[sgitg][tiisg * 4u]) = acc;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (sgitg != 0u) return;
