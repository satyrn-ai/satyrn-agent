+ * exact-prefill diagnostic (mellum_graph_alloc). */
+static uint32_t mellum_tiled_min_rows(const ds4_qwen4_gpu_graph *g) {
+    return g->mellum_exact_prefill ? UINT32_MAX : MELLUM_TILED_MIN_ROWS;
+}
