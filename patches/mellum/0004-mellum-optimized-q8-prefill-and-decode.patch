diff --git a/tests/mellum_logits_compare.py b/tests/mellum_logits_compare.py
new file mode 100644
index 00000000..b69f8796
--- /dev/null
+++ b/tests/mellum_logits_compare.py
@@ -0,0 +1,88 @@
+"""Compare two traced Mellum runs' logits, for tests/mellum_oracle_compare.sh.
+
+    python3 -I tests/mellum_logits_compare.py A B POSITIONS EXACT TOL KLTOL KLMAX DLOGP [NEARTIE]
+
+A and B are trace prefixes: the logits at position N are A.pN.logits.f32 (little-endian f32) and the
+session's last-row logits are A.session.logits.f32.  POSITIONS is a comma-separated list.  B is the
+reference.  EXACT 1: every file must be byte-equal; 0, for every row: the same top-1, or a different one
+where B's top two log-probabilities are within NEARTIE nats (default 0: none), max|d logit| <= TOL,
+KL(B || A) <= KLMAX and |log p_A(t) - log p_B(t)| <= DLOGP for B's top-1 token t; and over the traced
+positions, mean KL <= KLTOL.
+
+NEARTIE's value in tests/mellum_oracle_compare.sh, 0.75, was set on the four held-out files
+(tests/mellum_heldout_*.tokens, 64 positions each, n = 256): the release prefill, with the simdgroup or
+the tensor-tile experts, changed the exact path's top-1 at five of them, at margins of 0.002, 0.174, 0.369,
+0.524 and 0.718 nats; 0.75 is the widest rounded up (MELLUM.md, "Oracle caps").  The session row is the last position's row again, so it is held
+to the per-row rules but left out of the mean.  Under either rule every logit of both runs must be
+finite first.  Prints one summary line; exit 0 when the rules hold, 1 otherwise.
+"""
+
+import math
+import struct
+import sys
+
+
+def log_softmax(v):
+    m = max(v)
+    s = math.log(sum(math.exp(t - m) for t in v))
+    return [t - m - s for t in v]
+
+
+def main(argv):
+    a, b, positions, exact = argv[1], argv[2], argv[3].split(','), argv[4] == '1'
+    tol, kltol, klmax, dlogp = float(argv[5]), float(argv[6]), float(argv[7]), float(argv[8])
+    neartie = float(argv[9]) if len(argv) > 9 else 0.0
+    names = ['p%s' % p for p in positions] + ['session']
+    rows = []
+    for name in names:
+        x = open('%s.%s.logits.f32' % (a, name), 'rb').read()
+        y = open('%s.%s.logits.f32' % (b, name), 'rb').read()
+        u = struct.unpack('<%df' % (len(x) // 4), x)
+        v = struct.unpack('<%df' % (len(y) // 4), y)
+        for prefix, row in ((a, u), (b, v)):
+            bad = sum(not math.isfinite(t) for t in row)
+            if bad:
+                print('FAIL %s.%s.logits.f32: %d of %d logits are not finite' % (prefix, name, bad, len(row)))
+                return 1
+        rows.append((name, x, y, u, v))
+    worst, agree, near, equal, kl_sum = 0.0, 0, 0, 0, 0.0
+    kl_worst, kl_at, dl_worst, dl_at = 0.0, '-', 0.0, '-'
+    for name, x, y, u, v in rows:
+        equal += x == y
+        n = len(u)
+        worst = max(worst, max(abs(i - j) for i, j in zip(u, v)))
+        top = max(range(n), key=v.__getitem__)
+        same = max(range(n), key=u.__getitem__) == top
+        agree += same
+        if x == y:
+            continue
+        lq, lp = log_softmax(u), log_softmax(v)
+        if not same and lp[top] - max(t for i, t in enumerate(lp) if i != top) <= neartie:
+            near += 1
+        kl = sum(math.exp(pi) * (pi - qi) for pi, qi in zip(lp, lq) if pi > -27.6)
+        dl = abs(lq[top] - lp[top])
+        if name != 'session':
+            kl_sum += kl
+        if kl > kl_worst:
+            kl_worst, kl_at = kl, name
+        if dl > dl_worst:
+            dl_worst, dl_at = dl, name
+    kl_mean = kl_sum / len(positions)
+    if exact:
+        ok = equal == len(rows)
+        rule = 'byte-equal'
+    else:
+        ok = (agree + near == len(rows) and worst <= tol and kl_mean <= kltol and kl_worst <= klmax and
+              dl_worst <= dlogp)
+        rule = 'top-1 equal or a near-tie <= %g, max|d| <= %g, mean KL <= %g, worst KL <= %g, |d log p(top-1)| <= %g' % (
+            neartie, tol, kltol, klmax, dlogp)
+    changes = '' if exact else ' (%d change%s at a near-tie)' % (near, '' if near == 1 else 's')
+    print('%s (%s): %d of %d logits files byte-equal, top-1 agree %d/%d%s, max|d logit| %.3e, mean KL %.2e, '
+          'worst KL %.2e at %s, max |d log p(top-1)| %.2e at %s' %
+          ('ok  ' if ok else 'FAIL', rule, equal, len(rows), agree, len(rows), changes, worst, kl_mean,
+           kl_worst, kl_at, dl_worst, dl_at))
+    return 0 if ok else 1
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv))
diff --git a/tests/mellum_moe_ref.inc b/tests/mellum_moe_ref.inc
index 8fbcccff..fbd7a97a 100644
--- a/tests/mellum_moe_ref.inc
+++ b/tests/mellum_moe_ref.inc
@@ -83,3 +83,38 @@ static inline void mref_moe_row(const mref_weights *a, const float *x, mref_t *r
             r->out[o] += r->w[s] * mref_q8_dot(a->base + a->down + (e * MREF_E + o) * MREF_ROW_DOWN, mid, MREF_FF);
     }
 }
+
+/* The tiled expert GEMMs' staging (metal/qwen4.metal, kernel_qwen4_moe_mm_mid and _down): each Q8_0 weight as
+ * half(d * q), the input row and the SwiGLU output as half; the products are summed wider.  The router reads the
+ * row unstaged, so the selection and its weights are mref_moe_row's. */
+static inline double mref_q8_dot_staged(const uint8_t *row, const double *x_half, uint32_t n) {
+    double acc = 0.0;
+    for (uint32_t ib = 0; ib < n / 32u; ib++) {
+        const uint8_t *b = row + (uint64_t)ib * MREF_Q8_BLOCK_BYTES;
+        __fp16 h;
+        memcpy(&h, b, 2);
+        const float d = (float)h;
+        for (uint32_t j = 0; j < 32u; j++) {
+            const __fp16 w = (__fp16)(d * (float)(int8_t)b[2u + j]);
+            acc += (double)w * x_half[ib * 32u + j];
+        }
+    }
+    return acc;
+}
+
+static inline void mref_moe_row_staged(const mref_weights *a, const float *x, mref_t *r) {
+    mref_moe_row(a, x, r);   /* the selection and its weights */
+    double xh[MREF_E], mid[MREF_FF];
+    for (uint32_t i = 0; i < MREF_E; i++) xh[i] = (double)(__fp16)x[i];
+    for (uint32_t i = 0; i < MREF_E; i++) r->out[i] = 0.0;
+    for (uint32_t s = 0; s < MREF_USED; s++) {
+        const uint64_t e = (uint64_t)r->sel[s];
+        for (uint32_t f = 0; f < MREF_FF; f++) {
+            const double g = mref_q8_dot_staged(a->base + a->gate + (e * MREF_FF + f) * MREF_ROW_GATE, xh, MREF_E);
+            const double u = mref_q8_dot_staged(a->base + a->up + (e * MREF_FF + f) * MREF_ROW_GATE, xh, MREF_E);
+            mid[f] = (double)(__fp16)(float)(g / (1.0 + exp(-g)) * u);
+        }
+        for (uint32_t o = 0; o < MREF_E; o++)
+            r->out[o] += r->w[s] * mref_q8_dot_staged(a->base + a->down + (e * MREF_E + o) * MREF_ROW_DOWN, mid, MREF_FF);
+    }
+}
