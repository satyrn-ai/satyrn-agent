-/* Trunk layers repeat 3 GDN + 1 full attention; the MTP block is attention. */
+/* Mellum 2.1.  Also true for ds4_model_is_qwen4(). */
+static bool ds4_model_is_mellum(void) {
+    return DS4_MODEL_VARIANT == DS4_VARIANT_MELLUM;
+}
+
+/* Mellum's attention pattern: three sliding-window layers, then one full
+ * layer, i.e. layer il slides unless il % 4 == 3.  The validator checks this
+ * rule against the GGUF's sliding_window_pattern array. */
+static bool ds4_mellum_pattern_rule(uint32_t il) {
+    return (il + 1u) % 4u != 0u;
+}
+
+static bool ds4_mellum_layer_is_sliding(uint32_t il) {
+    return ds4_model_is_mellum() && ds4_mellum_pattern_rule(il);
+}
+
+/* Trunk layers repeat 3 GDN + 1 full attention; the MTP block is attention.
+ * Mellum has no GDN layer.  The guard is load-bearing: a Mellum shape leaves
+ * n_full_attn_interval 0, arm64 does not trap on % 0 (udiv gives 0, so
+ * x % 0 == x), and the rule below would call every Mellum layer linear. */
 static bool ds4_qwen4_layer_is_linear(uint32_t il) {
-    return ds4_model_is_qwen4() &&
+    return !ds4_model_is_mellum() &&
+           ds4_model_is_qwen4() &&
            il + DS4_N_NEXTN_PREDICT < DS4_N_LAYER &&
            (il + 1u) % DS4_N_FULL_ATTN_INTERVAL != 0u;
 }
 
 static bool ds4_qwen4_layer_is_ple(uint32_t il) {
-    return ds4_model_is_qwen4() && il == DS4_N_PLE_LAYER;
+    return ds4_model_is_qwen4() && !ds4_model_is_mellum() && il == DS4_N_PLE_LAYER;
 }
 
 static bool ds4_qwen4_layer_is_nextn(uint32_t il) {
-    return ds4_model_is_qwen4() && DS4_N_NEXTN_PREDICT != 0 &&
+    return ds4_model_is_qwen4() && !ds4_model_is_mellum() && DS4_N_NEXTN_PREDICT != 0 &&
            il + DS4_N_NEXTN_PREDICT >= DS4_N_LAYER;
 }
 
@@ -5346,7 +5392,8 @@ static void tensor_expect_routed_expert(
 
