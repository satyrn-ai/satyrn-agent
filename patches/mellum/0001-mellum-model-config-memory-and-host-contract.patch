diff --git a/tests/mellum_fixture.h b/tests/mellum_fixture.h
new file mode 100644
index 00000000..a4877ec6
--- /dev/null
+++ b/tests/mellum_fixture.h
@@ -0,0 +1,256 @@
+/* A sparse Mellum 2.1 GGUF for model-free tests: the real key set and the real
+ * tensor directory (every tensor at offset 0, so the file is a few hundred
+ * megabytes of holes), and a tiny vocabulary with 2.1's special tokens at their
+ * real ids followed by the 256 GPT-2 byte pieces and no merges, so text
+ * tokenizes to one id per byte (byte c is id 35 + c).  A mutation changes one
+ * thing, for a refusal test.  Self-contained: it does not include ds4.c, so the
+ * GGUF constants are restated here. */
+#ifndef DS4_TESTS_MELLUM_FIXTURE_H
+#define DS4_TESTS_MELLUM_FIXTURE_H
+
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+enum {
+    MF_GGUF_MAGIC = 0x46554747,   /* "GGUF" */
+    MF_UINT32 = 4, MF_INT32 = 5, MF_FLOAT32 = 6, MF_BOOL = 7, MF_STRING = 8, MF_ARRAY = 9,
+    MF_F32 = 0, MF_Q8_0 = 8, MF_Q4_K = 12, MF_MXFP4 = 39,
+};
+
+typedef enum {
+    MF_NONE = 0,
+    MF_PATTERN_FLIP,      /* one entry of sliding_window_pattern flipped */
+    MF_PATTERN_LEN27,     /* 27 entries for 28 blocks */
+    MF_PATTERN_LEN29,     /* 29 entries: the first 28 are right, only the length is wrong */
+    MF_PATTERN_ABSENT,
+    MF_ROPE_NOT_YARN,
+    MF_NO_FREQ_BASE_SWA,
+    MF_EXPERTS_128,
+    MF_USED_10,
+    MF_KEY_LENGTH_256,
+    MF_WINDOW_512,
+    MF_YARN_FACTOR_8,
+    MF_ATTN_FACTOR_1,
+    MF_ORIG_CTX_4096,
+    MF_SHEXP_TENSOR,      /* a shared-expert router in layer 0 */
+    MF_DOWN_Q4K,          /* layer 2's ffn_down_exps is Q4_K */
+    MF_UP_Q4K,            /* layer 2's ffn_up_exps is Q4_K */
+    MF_EXPERTS_MXFP4,     /* all 84 routed-expert tensors are MXFP4 */
+    MF_LAYER2_MXFP4,      /* only layer 2's three routed-expert tensors are MXFP4 */
+    MF_DOWN2_MXFP4,       /* only layer 2's ffn_down_exps is MXFP4 */
+    MF_NO_OUTPUT_NORM,
+    MF_NO_ATTN_Q_NORM,    /* layer 5 has no attn_q_norm */
+    MF_BAD_ATTN_Q_DIM,    /* layer 5's attn_q is twice as wide */
+    MF_NO_TOKEN_TYPE,     /* tokenizer.ggml.token_type absent */
+    MF_TOKEN_TYPE_SHORT,  /* one entry fewer than tokens */
+    MF_TOKEN_TYPE_U32,    /* the right values, stored as uint32 */
+    MF_NO_IM_START,       /* id 27 spelled something else: <|im_start|> absent */
+    MF_NO_IM_END,         /* id 28 spelled something else: <|im_end|> absent */
+    MF_EXTRA_CONTROL,     /* one more CONTROL token, spelled <zzz>, after the byte pieces */
+    MF_HEADS_16,          /* attention.head_count 16: a group of 4 still, which the old range check accepted */
+    MF_HEADS_KV_8,        /* attention.head_count_kv 8: a group of 4 still */
+    MF_EMBD_2336,         /* embedding_length 2336: a multiple of 32, not of 128 */
+} mf_mutation;
+
+typedef struct { char *p; size_t n, cap; } mf_buf;
+
+static void mf_put(mf_buf *b, const void *d, size_t n) {
+    if (b->n + n > b->cap) {
+        b->cap = (b->n + n) * 2 + 64;
+        b->p = realloc(b->p, b->cap);
+        assert(b->p);
+    }
+    memcpy(b->p + b->n, d, n);
+    b->n += n;
+}
+static void mf_u32(mf_buf *b, uint32_t v) { mf_put(b, &v, 4); }
+static void mf_u64(mf_buf *b, uint64_t v) { mf_put(b, &v, 8); }
+static void mf_str(mf_buf *b, const char *s) { mf_u64(b, strlen(s)); mf_put(b, s, strlen(s)); }
+
+typedef struct { mf_buf kv, tn; uint64_t n_kv, n_tensor; } mf_gguf;
+
+static void mf_kv_u32(mf_gguf *g, const char *k, uint32_t v) {
+    mf_str(&g->kv, k); mf_u32(&g->kv, MF_UINT32); mf_u32(&g->kv, v); g->n_kv++;
+}
+static void mf_kv_f32(mf_gguf *g, const char *k, float v) {
+    mf_str(&g->kv, k); mf_u32(&g->kv, MF_FLOAT32); mf_put(&g->kv, &v, 4); g->n_kv++;
+}
+static void mf_kv_str(mf_gguf *g, const char *k, const char *v) {
+    mf_str(&g->kv, k); mf_u32(&g->kv, MF_STRING); mf_str(&g->kv, v); g->n_kv++;
+}
+static void mf_kv_strs(mf_gguf *g, const char *k, const char *const *v, uint64_t n) {
+    mf_str(&g->kv, k); mf_u32(&g->kv, MF_ARRAY); mf_u32(&g->kv, MF_STRING); mf_u64(&g->kv, n);
+    for (uint64_t i = 0; i < n; i++) mf_str(&g->kv, v[i]);
+    g->n_kv++;
+}
+static void mf_kv_i32s(mf_gguf *g, const char *k, uint32_t etype, const int32_t *v, uint64_t n) {
+    mf_str(&g->kv, k); mf_u32(&g->kv, MF_ARRAY); mf_u32(&g->kv, etype); mf_u64(&g->kv, n);
+    for (uint64_t i = 0; i < n; i++) mf_put(&g->kv, &v[i], 4);
+    g->n_kv++;
+}
+static void mf_kv_bools(mf_gguf *g, const char *k, const bool *v, uint64_t n) {
+    mf_str(&g->kv, k); mf_u32(&g->kv, MF_ARRAY); mf_u32(&g->kv, MF_BOOL); mf_u64(&g->kv, n);
+    for (uint64_t i = 0; i < n; i++) { uint8_t x = v[i]; mf_put(&g->kv, &x, 1); }
+    g->n_kv++;
+}
+
+static void mf_tensor(mf_gguf *g, const char *name, uint32_t type, uint32_t ndim,
+                      uint64_t d0, uint64_t d1, uint64_t d2) {
+    mf_str(&g->tn, name); mf_u32(&g->tn, ndim);
+    mf_u64(&g->tn, d0);
+    if (ndim > 1) mf_u64(&g->tn, d1);
+    if (ndim > 2) mf_u64(&g->tn, d2);
+    mf_u32(&g->tn, type); mf_u64(&g->tn, 0);
+    g->n_tensor++;
+}
+
+static void mf_layer_tensor(mf_gguf *g, uint32_t il, const char *suffix, uint32_t type, uint32_t ndim,
+                            uint64_t d0, uint64_t d1, uint64_t d2) {
+    char name[128];
+    snprintf(name, sizeof(name), "blk.%u.%s", il, suffix);
+    mf_tensor(g, name, type, ndim, d0, d1, d2);
+}
+
+/* 2.1's hyperparameters, as its GGUF carries them. */
+static void mf_keys(mf_gguf *g, mf_mutation mu) {
+    bool pattern[29];
+    for (int i = 0; i < 29; i++) pattern[i] = (i % 4) != 3;
+    if (mu == MF_PATTERN_FLIP) pattern[3] = true;
+    mf_kv_str(g, "general.architecture", "mellum");
+    mf_kv_u32(g, "mellum.block_count", 28);
+    mf_kv_u32(g, "mellum.context_length", 131072);
+    mf_kv_u32(g, "mellum.embedding_length", mu == MF_EMBD_2336 ? 2336 : 2304);
+    mf_kv_u32(g, "mellum.feed_forward_length", 7168);
+    mf_kv_u32(g, "mellum.attention.head_count", mu == MF_HEADS_16 ? 16 : 32);
+    mf_kv_u32(g, "mellum.attention.head_count_kv", mu == MF_HEADS_KV_8 ? 8 : 4);
+    mf_kv_str(g, "mellum.rope.scaling.type", mu == MF_ROPE_NOT_YARN ? "linear" : "yarn");
+    mf_kv_f32(g, "mellum.rope.scaling.factor", mu == MF_YARN_FACTOR_8 ? 8.0f : 16.0f);
+    mf_kv_u32(g, "mellum.rope.scaling.original_context_length", mu == MF_ORIG_CTX_4096 ? 4096 : 8192);
+    mf_kv_f32(g, "mellum.rope.scaling.yarn_attn_factor", mu == MF_ATTN_FACTOR_1 ? 1.0f : 1.2772588729858398f);
+    mf_kv_f32(g, "mellum.rope.scaling.yarn_beta_fast", 32.0f);
+    mf_kv_f32(g, "mellum.rope.scaling.yarn_beta_slow", 1.0f);
+    mf_kv_f32(g, "mellum.rope.freq_base", 500000.0f);
+    if (mu != MF_NO_FREQ_BASE_SWA) mf_kv_f32(g, "mellum.rope.freq_base_swa", 500000.0f);
+    mf_kv_f32(g, "mellum.attention.layer_norm_rms_epsilon", 1.0e-6f);
+    mf_kv_u32(g, "mellum.expert_count", mu == MF_EXPERTS_128 ? 128 : 64);
+    mf_kv_u32(g, "mellum.expert_used_count", mu == MF_USED_10 ? 10 : 8);
+    mf_kv_u32(g, "mellum.attention.key_length", mu == MF_KEY_LENGTH_256 ? 256 : 128);
+    mf_kv_u32(g, "mellum.attention.value_length", 128);
+    mf_kv_u32(g, "mellum.expert_feed_forward_length", 896);
+    mf_kv_u32(g, "mellum.attention.sliding_window", mu == MF_WINDOW_512 ? 512 : 1024);
+    if (mu != MF_PATTERN_ABSENT) {
+        mf_kv_bools(g, "mellum.attention.sliding_window_pattern", pattern,
+                    mu == MF_PATTERN_LEN27 ? 27 : mu == MF_PATTERN_LEN29 ? 29 : 28);
+    }
+}
+
+/* The special ids at their real places and spellings (2.1's tokenizer_config.json),
+ * then the 256 byte-level pieces. */
+static void mf_vocab(mf_gguf *g, mf_mutation mu) {
+    static char fill[35][24], bytes[256][8];
+    const char *tok[35 + 256 + 1];
+    const int ntok = 35 + 256 + (mu == MF_EXTRA_CONTROL ? 1 : 0);
+    for (int i = 0; i < 35; i++) { snprintf(fill[i], sizeof(fill[i]), "<fill_%d>", i); tok[i] = fill[i]; }
+    tok[0] = "<|endoftext|>"; tok[1] = "<assistant>"; tok[2] = "</assistant>";
+    tok[3] = "<commit_before>"; tok[4] = "<commit_after>"; tok[5] = "<commit_msg>";
+    tok[6] = "<empty_output>"; tok[7] = "<filename>"; tok[8] = "<fim_prefix>";
+    tok[9] = "<fim_middle>"; tok[10] = "<fim_suffix>"; tok[11] = "<fim_pad>";
+    tok[12] = "<gh_stars>"; tok[13] = "<issue_start>"; tok[14] = "<issue_comment>";
+    tok[15] = "<issue_closed>"; tok[16] = "<jupyter_text>"; tok[17] = "<jupyter_code>";
+    tok[18] = "<jupyter_start>"; tok[19] = "<jupyter_output>"; tok[20] = "<reponame>";
+    tok[21] = "<system>"; tok[22] = "</system>"; tok[23] = "<think>"; tok[24] = "</think>";
+    tok[25] = "<user>"; tok[26] = "</user>";
+    tok[27] = mu == MF_NO_IM_START ? "<|im_begin|>" : "<|im_start|>";
+    tok[28] = mu == MF_NO_IM_END ? "<|im_finish|>" : "<|im_end|>";
+    tok[29] = "<tool_call>"; tok[30] = "</tool_call>";
+    tok[31] = "<tool_response>"; tok[32] = "</tool_response>";
+    tok[33] = "<|extra_token_7|>"; tok[34] = "<|extra_token_8|>";
+    int extra = 0;
+    for (int c = 0; c < 256; c++) {
+        const bool direct = (c >= 33 && c <= 126) || (c >= 161 && c <= 172) || (c >= 174);
+        const int cp = direct ? c : 256 + extra++;
+        if (cp < 0x80) { bytes[c][0] = (char)cp; bytes[c][1] = 0; }
+        else { bytes[c][0] = (char)(0xC0 | (cp >> 6)); bytes[c][1] = (char)(0x80 | (cp & 0x3F)); bytes[c][2] = 0; }
+        tok[35 + c] = bytes[c];
+    }
+    if (mu == MF_EXTRA_CONTROL) tok[35 + 256] = "<zzz>";
+    mf_kv_str(g, "tokenizer.ggml.model", "gpt2");
+    mf_kv_str(g, "tokenizer.ggml.pre", "mellum2");
+    mf_kv_strs(g, "tokenizer.ggml.tokens", tok, (uint64_t)ntok);
+    mf_kv_strs(g, "tokenizer.ggml.merges", NULL, 0);
+    /* as 2.1's file has them: 0-22, 25-28, 33, 34 CONTROL (3); 23, 24, 29-32
+     * USER_DEFINED (4); the byte pieces NORMAL (1) */
+    static int32_t types[35 + 256 + 1];
+    for (int i = 0; i < 35 + 256; i++) types[i] = i >= 35 ? 1 : 3;
+    types[35 + 256] = 3;
+    types[23] = types[24] = types[29] = types[30] = types[31] = types[32] = 4;
+    if (mu != MF_NO_TOKEN_TYPE) {
+        mf_kv_i32s(g, "tokenizer.ggml.token_type", mu == MF_TOKEN_TYPE_U32 ? MF_UINT32 : MF_INT32, types,
+                   mu == MF_TOKEN_TYPE_SHORT ? (uint64_t)ntok - 1 : (uint64_t)ntok);
+    }
+    mf_kv_u32(g, "tokenizer.ggml.bos_token_id", 0);
+    mf_kv_u32(g, "tokenizer.ggml.eos_token_id", 28);
+    mf_kv_u32(g, "tokenizer.ggml.unknown_token_id", 0);
+    mf_kv_u32(g, "tokenizer.ggml.padding_token_id", 0);
+}
+
+/* 2.1's tensor directory (Q8_0 projections and experts, F32 norms and router). */
+static void mf_tensors(mf_gguf *g, mf_mutation mu) {
+    const uint32_t Q8 = MF_Q8_0, F32 = MF_F32;
+    mf_tensor(g, "output.weight", Q8, 2, 2304, 98304, 0);
+    if (mu != MF_NO_OUTPUT_NORM) mf_tensor(g, "output_norm.weight", F32, 1, 2304, 0, 0);
+    mf_tensor(g, "token_embd.weight", Q8, 2, 2304, 98304, 0);
+    for (uint32_t il = 0; il < 28; il++) {
+        const uint32_t X = mu == MF_EXPERTS_MXFP4 || (mu == MF_LAYER2_MXFP4 && il == 2) ? MF_MXFP4 : Q8;
+        mf_layer_tensor(g, il, "attn_k.weight", Q8, 2, 2304, 512, 0);
+        mf_layer_tensor(g, il, "attn_k_norm.weight", F32, 1, 128, 0, 0);
+        mf_layer_tensor(g, il, "attn_norm.weight", F32, 1, 2304, 0, 0);
+        mf_layer_tensor(g, il, "attn_output.weight", Q8, 2, 4096, 2304, 0);
+        mf_layer_tensor(g, il, "attn_q.weight", Q8, 2, 2304, mu == MF_BAD_ATTN_Q_DIM && il == 5 ? 8192 : 4096, 0);
+        if (!(mu == MF_NO_ATTN_Q_NORM && il == 5)) mf_layer_tensor(g, il, "attn_q_norm.weight", F32, 1, 128, 0, 0);
+        mf_layer_tensor(g, il, "attn_v.weight", Q8, 2, 2304, 512, 0);
+        mf_layer_tensor(g, il, "ffn_down_exps.weight",
+                        mu == MF_DOWN_Q4K && il == 2 ? MF_Q4_K : mu == MF_DOWN2_MXFP4 && il == 2 ? MF_MXFP4 : X,
+                        3, 896, 2304, 64);
+        mf_layer_tensor(g, il, "ffn_gate_exps.weight", X, 3, 2304, 896, 64);
+        mf_layer_tensor(g, il, "ffn_gate_inp.weight", F32, 2, 2304, 64, 0);
+        mf_layer_tensor(g, il, "ffn_norm.weight", F32, 1, 2304, 0, 0);
+        mf_layer_tensor(g, il, "ffn_up_exps.weight", mu == MF_UP_Q4K && il == 2 ? MF_Q4_K : X, 3, 2304, 896, 64);
+        if (mu == MF_SHEXP_TENSOR && il == 0) mf_layer_tensor(g, il, "ffn_gate_inp_shexp.weight", F32, 1, 2304, 0, 0);
+    }
+}
+
+/* Write the fixture to a fresh temporary file; path receives its name (the caller unlinks). */
+static void mellum_fixture_write(mf_mutation mu, char *path, size_t path_cap) {
+    mf_gguf g;
+    memset(&g, 0, sizeof(g));
+    mf_keys(&g, mu);
+    mf_vocab(&g, mu);
+    mf_tensors(&g, mu);
+
+    mf_buf head = {0};
+    mf_u32(&head, MF_GGUF_MAGIC);
+    mf_u32(&head, 3);
+    mf_u64(&head, g.n_tensor);
+    mf_u64(&head, g.n_kv);
+    mf_put(&head, g.kv.p, g.kv.n);
+    mf_put(&head, g.tn.p, g.tn.n);
+    const uint64_t data_pos = (head.n + 31u) & ~(uint64_t)31u;
+    const uint64_t file_size = data_pos + 260ull * 1000 * 1000;   /* > output.weight, 240 MB */
+
+    const char *tmp = getenv("TMPDIR");
+    snprintf(path, path_cap, "%s/mellum-fixture.XXXXXX", tmp && tmp[0] ? tmp : "/tmp");
+    const int fd = mkstemp(path);
+    assert(fd >= 0);
+    assert(write(fd, head.p, head.n) == (ssize_t)head.n);
+    assert(ftruncate(fd, (off_t)file_size) == 0);
+    assert(close(fd) == 0);
+    free(g.kv.p); free(g.tn.p); free(head.p);
+}
+
+#endif
diff --git a/tests/test_mellum_config.c b/tests/test_mellum_config.c
new file mode 100644
index 00000000..608fd5e6
--- /dev/null
+++ b/tests/test_mellum_config.c
@@ -0,0 +1,665 @@
+/* Mellum 2.1 recognition, validation, binding and memory plan, model-free.  Each
+ * case writes the sparse GGUF of tests/mellum_fixture.h and opens it through
+ * model_open / config_validate_model / weights_bind, or ds4_engine_open.  The
+ * validators exit(1) with a message, so a refusal is checked in a forked child
+ * whose stderr is read back and must name what it refuses. */
+#include "../ds4.c"
+#include "mellum_fixture.h"
+#include <sys/wait.h>
+
+#define CHECK(c) do { if (!(c)) { fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); exit(1); } } while (0)
+
+/* Run fn in a child; return its exit status and what it wrote to stderr. */
+typedef void (*child_fn)(const char *path);
+
+static int run_child(child_fn fn, const char *path, char *err, size_t cap) {
+    int pipefd[2];
+    CHECK(pipe(pipefd) == 0);
+    fflush(stdout);   /* a child's exit(1) would otherwise flush a copy of our pending output */
+    fflush(stderr);
+    const pid_t pid = fork();
+    CHECK(pid >= 0);
+    if (pid == 0) {
+        close(pipefd[0]);
+        dup2(pipefd[1], 2);
+        close(pipefd[1]);
+        fn(path);
+        _exit(0);
+    }
+    close(pipefd[1]);
+    size_t n = 0;
+    ssize_t r;
+    while (n + 1 < cap && (r = read(pipefd[0], err + n, cap - 1 - n)) > 0) n += (size_t)r;
+    err[n] = '\0';
+    close(pipefd[0]);
+    int status = 0;
+    CHECK(waitpid(pid, &status, 0) == pid);
+    return WIFEXITED(status) ? WEXITSTATUS(status) : 128 + WTERMSIG(status);
+}
+/* general.architecture = mellum names the variant, inside the QWEN4_EXP family. */
+static void check_variant(void) {
+    char path[512];
+    mellum_fixture_write(MF_NONE, path, sizeof(path));
+    ds4_model m;
+    model_open(&m, path, false, false);
+    config_validate_model(&m);
+    CHECK(ds4_model_is_mellum());
+    CHECK(ds4_model_is_qwen4());
+    CHECK(DS4_MODEL_FAMILY == DS4_MODEL_FAMILY_QWEN4_EXP);
+    CHECK(DS4_MODEL_VARIANT == DS4_VARIANT_MELLUM);
+    model_close(&m);
+    unlink(path);
+
+    /* sibling: the Qwen3.8 shapes are not Mellum */
+    g_ds4_shape = DS4_SHAPE_QWEN4_EXP;
+    CHECK(!ds4_model_is_mellum() && ds4_model_is_qwen4());
+    g_ds4_shape = DS4_SHAPE_QWEN4_MINI;
+    CHECK(!ds4_model_is_mellum() && ds4_model_is_qwen4());
+    printf("ok   variant: mellum is its own variant in the QWEN4_EXP family\n");
+}
+/* What an open does with the file before the forward pass: validate the
+ * keys, then bind and check every tensor of the full model. */
+static void child_validate(const char *path) {
+    ds4_model m;
+    model_open(&m, path, false, false);
+    config_validate_model(&m);
+    ds4_weights w;
+    weights_bind(&w, &m, false, 0, UINT32_MAX, true, false);
+    model_close(&m);
+}
+
+/* Refused: exits 1 and the message names `needle`. */
+static void expect_refused(mf_mutation mu, const char *needle, const char *label) {
+    char path[512], err[4096];
+    mellum_fixture_write(mu, path, sizeof(path));
+    const int rc = run_child(child_validate, path, err, sizeof(err));
+    unlink(path);
+    if (rc != 1 || !strstr(err, needle)) {
+        fprintf(stderr, "FAIL %s: exit %d, stderr [%s], wanted exit 1 naming '%s'\n", label, rc, err, needle);
+        exit(1);
+    }
+    printf("ok   refused: %-34s names %s\n", label, needle);
+}
+
+static void expect_accepted(mf_mutation mu, const char *label) {
+    char path[512], err[4096];
+    mellum_fixture_write(mu, path, sizeof(path));
+    const int rc = run_child(child_validate, path, err, sizeof(err));
+    unlink(path);
+    if (rc != 0) {
+        fprintf(stderr, "FAIL %s: exit %d, stderr [%s]\n", label, rc, err);
+        exit(1);
+    }
+    printf("ok   accepted: %s\n", label);
+}
+/* The real key set gives the shape the kernels are written for, the 3:1
+ * sliding pattern, and resets what a model opened earlier left behind. */
+static void check_good_set_in_process(void) {
+    char path[512];
+    mellum_fixture_write(MF_NONE, path, sizeof(path));
+    g_ds4_qwen4_ple.n_heads = 7;                     /* stale PLE state from another model */
+    g_ds4_compress_ratios[3] = 4;
+    g_qwen4_native_ctx = 262144;                     /* stale rope state from a Qwen model */
+    g_qwen4_rope_yarn = true;
+    g_qwen4_rope_freq[0] = 7.0f;
+    g_qwen4_rope_mscale = 2.0f;
+    ds4_model m;
+    model_open(&m, path, false, false);
+    config_validate_model(&m);
+
+    CHECK(DS4_N_LAYER == 28 && DS4_N_EMBD == 2304 && DS4_N_VOCAB == 98304);
+    CHECK(DS4_N_HEAD == 32 && DS4_N_HEAD_KV == 4 && DS4_N_HEAD_DIM == 128 && DS4_N_VALUE_DIM == 128);
+    CHECK(DS4_N_ROT == 128 && DS4_N_SWA == 1024);
+    CHECK(DS4_N_EXPERT == 64 && DS4_N_EXPERT_USED == 8 && DS4_N_FF_EXP == 896);
+    CHECK(DS4_N_FF_DENSE == 0);                      /* feed_forward_length (7168) is not a dense FFN */
+    CHECK(DS4_N_EXPERT_SHARED == 0 && DS4_N_NEXTN_PREDICT == 0 && DS4_N_HC == 1);
+    CHECK(DS4_ROPE_FREQ_BASE == 500000.0f && DS4_ROPE_FREQ_BASE_SWA == 500000.0f);
+    CHECK(DS4_ROPE_SCALE_FACTOR == 16.0f && DS4_ROPE_ORIG_CTX == 8192);
+    CHECK(DS4_ROPE_YARN_BETA_FAST == 32.0f && DS4_ROPE_YARN_BETA_SLOW == 1.0f);
+    CHECK(fabsf(DS4_ROPE_YARN_ATTN_FACTOR - 1.2772589f) < 1.0e-6f);
+    CHECK(g_ds4_qwen4_ple.n_heads == 0 && g_ds4_compress_ratios[3] == 0);
+    CHECK(g_qwen4_native_ctx == 0 && !g_qwen4_rope_yarn && g_qwen4_rope_freq[0] == 0.0f &&
+          g_qwen4_rope_mscale == 1.0f);
+
+    /* layers 0, 1, 2 slide; 3 and 27 are full; 21 of 28 slide */
+    CHECK(ds4_mellum_layer_is_sliding(0) && ds4_mellum_layer_is_sliding(1) && ds4_mellum_layer_is_sliding(2));
+    CHECK(!ds4_mellum_layer_is_sliding(3) && !ds4_mellum_layer_is_sliding(27));
+    uint32_t n_sliding = 0;
+    for (uint32_t il = 0; il < DS4_N_LAYER; il++) n_sliding += ds4_mellum_layer_is_sliding(il);
+    CHECK(n_sliding == 21);
+    /* without its guard the GDN predicate is silently true here (interval 0, and
+     * arm64 udiv makes x % 0 == x) */
+    CHECK(DS4_N_FULL_ATTN_INTERVAL == 0);
+    for (uint32_t il = 0; il < DS4_N_LAYER; il++) {
+        CHECK(!ds4_qwen4_layer_is_linear(il));
+        CHECK(!ds4_qwen4_layer_is_ple(il));
+        CHECK(!ds4_qwen4_layer_is_nextn(il));
+    }
+    /* the guards hold even if a shape field the Qwen rules read were set */
+    {
+        const ds4_shape saved = g_ds4_shape;
+        g_ds4_shape.n_full_attn_interval = 4;
+        g_ds4_shape.n_ple_layer = 0;
+        g_ds4_shape.n_nextn_predict = 1;
+        for (uint32_t il = 0; il < DS4_N_LAYER; il++) {
+            CHECK(!ds4_qwen4_layer_is_linear(il));
+            CHECK(!ds4_qwen4_layer_is_ple(il));
+            CHECK(!ds4_qwen4_layer_is_nextn(il));
+        }
+        g_ds4_shape = saved;
+    }
+
+    ds4_weights w;
+    weights_bind(&w, &m, false, 0, UINT32_MAX, true, false);
+    CHECK(w.token_embd && w.output && w.output_norm);
+    CHECK(w.output != w.token_embd);                 /* untied head */
+    CHECK(!w.output_hc_down && !w.output_hc_up && !w.output_hc_norm && !w.ple_embd);
+    CHECK(weights_have_output_head(&w));
+    for (uint32_t il = 0; il < DS4_N_LAYER; il++) {
+        const ds4_layer_weights *l = &w.layer[il];
+        CHECK(l->attn_norm && l->ffn_norm && l->attn_q && l->attn_k && l->attn_v && l->attn_output);
+        CHECK(l->attn_q_norm && l->attn_k_norm && l->ffn_gate_inp);
+        CHECK(l->ffn_gate_exps && l->ffn_up_exps && l->ffn_down_exps);
+        CHECK(!l->ffn_gate_inp_shexp && !l->ffn_gate_shexp && !l->ffn_up_shexp && !l->ffn_down_shexp);
+        CHECK(!l->hc_attn_norm && !l->lin_qkv && !l->indexer_q_proj && !l->ple_key);
+        CHECK(weights_layer_has_required(l, il));
+    }
+    model_close(&m);
+    unlink(path);
+    printf("ok   good key set: shape, sliding pattern, predicates, stale state reset, binding\n");
+}
