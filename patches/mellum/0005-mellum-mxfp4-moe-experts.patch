+/* eight distinct experts, in a random order */
+static void addr_pick(int32_t sel[MREF_USED]) {
+    for (uint32_t k = 0; k < MREF_USED; k++) {
+        int32_t e;
+        bool dup;
+        do {
+            e = (int32_t)((uint32_t)((frand() + 1.0f) * 32.0f) % MREF_NEXP);
+            dup = false;
+            for (uint32_t j = 0; j < k; j++) dup = dup || sel[j] == e;
+        } while (dup);
+        sel[k] = e;
+    }
+}
