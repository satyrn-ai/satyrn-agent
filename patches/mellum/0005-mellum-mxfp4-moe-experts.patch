+    require_ok(ds4_gpu_qwen4_moe_mm_mid_tensor(mid, xt, lists, counts, a->base, a->size, a->gate, a->up, a->expert_type,
+                                               MREF_NEXP, T, K, K, MREF_E, MREF_FF, T), "moe_mm mid");
