+}
+
+static void addr_slots_free(addr_slots_t *s) {
+    for (uint32_t e = 0; e < MREF_NEXP; e++) {
+        ds4_gpu_tensor_free(s->gate[e]); ds4_gpu_tensor_free(s->up[e]); ds4_gpu_tensor_free(s->down[e]);
+    }
