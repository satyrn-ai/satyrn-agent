     const ds4_model *m = &engine->model;
     const ds4_tensor *r = tensor_by_namef(m, "blk.%u.ffn_gate_inp.weight", layer);
@@ -89004,6 +89022,7 @@ bool ds4_test_mellum_moe_weights(ds4_engine *engine, uint32_t layer, const void
     *gate = g->abs_offset;
     *up = u->abs_offset;
     *down = d->abs_offset;
