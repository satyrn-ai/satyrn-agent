{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scenario",
  "description": "A deterministic model-free public-flow E2E scenario.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "backend",
    "native",
    "config",
    "rounds",
    "expected_branches"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "snapshot_parity": {
      "type": "boolean",
      "default": false
    },
    "ctx": {
      "type": "integer",
      "minimum": 1,
      "description": "Native context size used by public open."
    },
    "think": {
      "type": "integer",
      "minimum": 0,
      "description": "ds4 ThinkMode used by public open; zero disables thinking."
    },
    "raw_config": {
      "type": "object",
      "description": "Optional raw Python config mapping for public constructor validation scenarios."
    },
    "backend": {
      "type": "string",
      "enum": [
        "metal",
        "cpu"
      ]
    },
    "native": {
      "$ref": "#/$defs/Native"
    },
    "config": {
      "$ref": "../../../schemas/satyrn-config.schema.json"
    },
    "rounds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/Round"
      }
    },
    "expected_branches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "Native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "calls"
      ],
      "properties": {
        "script": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NativeCall"
          }
        },
        "stop_tokens": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "uniqueItems": true,
          "default": []
        },
        "has_dflash": {
          "type": "boolean",
          "default": true
        },
        "verify_rows": {
          "type": "integer",
          "minimum": 0,
          "default": 8
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "default": []
        },
        "sampling_defaults": {
          "oneOf": [
            {
              "$ref": "#/$defs/SamplingDefaults"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "end_think_tokens": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "NativeCall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "draft",
            "verify",
            "select",
            "commit",
            "eval",
            "sample",
            "mode",
            "has_dflash",
            "verify_rows",
            "sampling_defaults"
          ]
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "default": []
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "Zero-based sample index for a sample fault."
        },
        "value": {
          "type": "integer"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "nonfinite": {
          "type": "boolean"
        },
        "status": {
          "type": "integer"
        },
        "count": {
          "type": "integer"
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "side_effect": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "SamplingDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature",
        "top_k",
        "top_p",
        "min_p"
      ],
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0
        },
        "top_k": {
          "type": "integer",
          "minimum": 0
        },
        "top_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "Round": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "max_tokens",
        "expect"
      ],
      "properties": {
        "prompt": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "raw",
            "chat"
          ],
          "default": "raw"
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "stop_sequences": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "cancel_after_samples": {
          "type": "integer",
          "minimum": -3,
          "description": "Sample index to cancel at; -1 selects before a row sample, -2 cancels during native commit, and -3 cancels before the round."
        },
        "resume_zero_reserve": {
          "type": "boolean",
          "default": false,
          "description": "Resume the first reserve pause with zero reserve; fail any later pause."
        },
        "hook_error_at": {
          "type": "integer",
          "minimum": 1
        },
        "finish_at": {
          "type": "integer",
          "minimum": 0
        },
        "finish_reason": {
          "type": "string",
          "minLength": 1
        },
        "cancel_after_accept": {
          "type": "integer",
          "minimum": 1
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ToolDefinition"
          },
          "default": []
        },
        "expect": {
          "$ref": "#/$defs/Expectation"
        }
      }
    },
    "Expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason",
        "token_ids",
        "native_position",
        "rng",
        "metrics",
        "metadata",
        "event_types"
      ],
      "properties": {
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "token_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "native_position": {
          "type": "integer",
          "minimum": 0
        },
        "rng": {
          "type": "integer",
          "minimum": 0
        },
        "metrics": {
          "$ref": "#/$defs/Metrics"
        },
        "metadata": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SampleMetadata"
          }
        },
        "event_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sampling_defaults": {
          "$ref": "#/$defs/SamplingDefaults"
        },
        "transcript": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EventExpectation"
          }
        },
        "native_calls": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NativeCallExpectation"
          }
        },
        "token_positions": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "ToolDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "parameters"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "EventExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "payload"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "NativeCallExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string"
        },
        "anchor": {
          "type": "integer"
        },
        "drafts": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "maximum": {
          "type": "integer",
          "minimum": 0
        },
        "row": {
          "type": "integer",
          "minimum": 0
        },
        "rows": {
          "type": "integer",
          "minimum": 1
        },
        "token": {
          "type": "integer"
        }
      }
    },
    "Metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "committed_blocks",
        "drafts_offered",
        "drafts_accepted",
        "replacement_anchors",
        "discarded_tails"
      ],
      "properties": {
        "committed_blocks": {
          "type": "integer",
          "minimum": 0
        },
        "drafts_offered": {
          "type": "integer",
          "minimum": 0
        },
        "drafts_accepted": {
          "type": "integer",
          "minimum": 0
        },
        "replacement_anchors": {
          "type": "integer",
          "minimum": 0
        },
        "discarded_tails": {
          "type": "integer",
          "minimum": 0
        },
        "acceptance_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "SampleMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "think_tokens",
        "sampled_tokens"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "think_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "sampled_tokens": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "parser_state": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    }
  }
}
